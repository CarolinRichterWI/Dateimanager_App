{
  "name": "dateimanager-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ionic Vue Dateimanager-App für Android mit vollständiger Datei-, Ordner- und ZIP-Verwaltung.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run build && cap run android",
    "zip:setup": "node scripts/setup-capawesome.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "8.1.2",
    "@capawesome/capacitor-file-picker": "8.0.3",
    "@capawesome-team/capacitor-file-opener": "8.0.1",
    "@ionic/vue": "8.8.15",
    "@ionic/vue-router": "8.8.15",
    "ionicons": "8.0.13",
    "jszip": "3.10.1",
    "vue": "3.5.40",
    "vue-router": "4.6.4"
  },
  "optionalDependencies": {
    "@capawesome-team/capacitor-zip": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@capacitor/assets": "3.0.5",
    "@types/node": "24.10.13",
    "@vitejs/plugin-vue": "6.0.8",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  },
  "engines": {
    "node": ">=22"
  }
}
